# Better Auth Secret & App URL (BETTER_AUTH_SECRET must match assignment_09_server)
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Express Backend API URL
API_BASE_URL=http://localhost:8000

# MongoDB Connection (used by Better Auth adapter)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ImgBB Image Hosting API Key (Server-side only — never exposed to browser)
IMGBB_API_KEY=your_imgbb_api_key_here

# Stripe Publishable Key (Client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
